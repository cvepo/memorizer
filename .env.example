# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# --- Session signing ------------------------------------------------------
# Any long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Passwords ------------------------------------------------------------
# bcrypt hashes, NOT the raw passwords. Generate with:
#   npm run hash -- "the-password"
#
# IMPORTANT: in .env files every "$" must be escaped as "\$". Next.js expands
# unescaped ones away, which silently truncates the hash and makes every
# password look wrong. `npm run hash` prints the escaped form ready to paste.
# Values set in the Vercel dashboard or CLI are taken verbatim — no escaping.
# Study password: sign in, study, record your own progress.
SITE_PASSWORD_HASH=

# --- Admin sign-in ---------------------------------------------------------
# Email + password. Everything above, plus import and edit course material.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
